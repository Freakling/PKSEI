&"antic_nap": PackedStringArray("Bara blunda lite...", "Väck mig vid ön", "Zzz... va?"),
&"antic_pee": PackedStringArray("Jag måste pissa", "Kissnödig!", "Blåsan säger stopp"),
&"antic_puke": PackedStringArray("Nu kommer det...", "Håll i båten!", "Jag mår inte bra..."),
&"bar_windup": PackedStringArray("Oj, allt snurrar!", "Vilket håll är fram?", "Nu är jag rund under fötterna"),
&"jump_windup": PackedStringArray("Min öl!!", "Nej, inte ölen!", "Jag hämtar den!"),
&"geese": PackedStringArray("Se upp för fåglarna!", "Gäss! Paddla!", "Jävla gäss!"),
&"gust": PackedStringArray("Nu jävlar blåser det!", "Håll i hatten!", "Vind! Åt andra hållet!"),
&"headwind": PackedStringArray("Motvind, fy fan", "Ta i nu, grabbar!", "Vågor framför!"),
&"wake": PackedStringArray("Motorbåt! Vänd bogen!", "Svall på väg!", "Vem fan kör så?"),
&"jetski": PackedStringArray("Vattenskoter! Se upp!", "Hör ni den där idioten?", "Ur vägen, skoter!"),
&"beast": PackedStringArray("Nåt är i vattnet...", "Fenan! Det är odjuret!", "Loch-Brez! Paddla för fan!"),
&"edge": PackedStringArray("Inte för långt ut!", "Vänd om, här bor odjuret!", "Håll er på sjön!"),
&"log": PackedStringArray("Stock rakt fram!", "Styr, det ligger en stock!", "Se upp för stocken!"),
&"rock": PackedStringArray("Sten! Styr undan!", "Det är en sten där!", "Boj rakt fram!"),
&"snag": PackedStringArray("Fan, linan!", "Jag sitter fast!", "Vems jävla lina är det här?!", "Flytta på din rev, gubbe!"),
&"swim_fetch": PackedStringArray("Jag tar den!", "Simma simma...", "Kom hit, ölen!"),
